{
  "name": "rosario-properties-bot",
  "version": "1.0.0",
  "description": "Bot de WhatsApp para consulta de propiedades en Rosario",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "chmod +x scripts/prebuild.sh && ./scripts/prebuild.sh",
    "load-data": "node scripts/loadToQdrant.js",
    "load-multiple": "node scripts/loadMultipleFiles.js",
    "load-fixed": "node scripts/fixedLoader.js",
    "load-final": "node scripts/finalLoader.js",
    "load-incremental": "node scripts/incrementalLoader.js",
    "setup": "node scripts/setup.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "real-estate",
    "qdrant"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@qdrant/js-client-rest": "^1.15.1",
    "axios": "^1.6.2",
    "better-sqlite3": "^9.6.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "openai": "^4.104.0",
    "prebuild-install": "^7.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
